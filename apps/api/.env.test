# Test settings (committed). `tests/conftest.py` sets ENVIRONMENT=test, which selects this file.
ENVIRONMENT=test
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sclm_test
REDIS_URL=redis://localhost:6379/15
CELERY_BROKER_URL=redis://localhost:6379/15
CELERY_RESULT_BACKEND=redis://localhost:6379/15
JWT_SECRET=test-only-secret-that-is-at-least-32-characters-long
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
EMAIL_BACKEND=outbox
EMAIL_FROM=no-reply@example.com
PUSH_BACKEND=outbox
METRICS_ENABLED=true
# Accounts are created by an admin (`uv run python -m app.cli create-user`) unless this is on
SELF_REGISTRATION_ENABLED=true
# Contract files: RustFS from `pnpm infra:up` (console http://localhost:9001)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=sclm-files-test
